###############################################################################
# Fides — Environment Configuration
#
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
# Only variables prefixed with `NEXT_PUBLIC_` are exposed to the browser.
#
# Unfilled placeholders (written as `<like-this>`) and reserved example hosts
# (e.g. `smtp.example.com`) are treated as unset, so integrations stay in their
# development/fallback mode until real values are provided.
###############################################################################

# -----------------------------------------------------------------------------
# Platform / Application
# -----------------------------------------------------------------------------
# Canonical URL of the deployed application (used for metadata, redirects, emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Root domain that tenant booking sites are served from via wildcard subdomain
# routing, e.g. a tenant `acme` is served at https://acme.<domain>.
NEXT_PUBLIC_PLATFORM_DOMAIN=fides.app

# -----------------------------------------------------------------------------
# Supabase (database, auth, storage, realtime, pgvector)
# Project Settings -> API in the Supabase dashboard.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Public "publishable" key (sb_publishable_...) — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
# Legacy alias, still accepted: NEXT_PUBLIC_SUPABASE_ANON_KEY=<legacy-anon-key>
# Secret key (sb_secret_...) / service-role key — SERVER ONLY.
# Bypasses Row Level Security; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=<supabase-secret-or-service-role-key>
# JWT secret used to sign access tokens (Project Settings -> API -> JWT Settings).
# Optional; used for server-side verification of tenant claims.
SUPABASE_JWT_SECRET=<supabase-jwt-secret>

# -----------------------------------------------------------------------------
# Google Gemini API (AI Concierge)
# API key from Google AI Studio: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=<gemini-api-key>
# Model id used for concierge conversations.
GEMINI_MODEL=gemini-2.0-flash
# Hard response ceiling in milliseconds (SRS 3.4 / SPMP constraint 4).
AI_CONCIERGE_TIMEOUT_MS=3000

# -----------------------------------------------------------------------------
# SMTP (transactional email: confirmations, status updates, billing reminders)
# Works with SendGrid, Resend, Brevo, or any SMTP relay.
# When SMTP_HOST / MAIL_FROM_EMAIL are absent, a console transport is used.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=<smtp-password>
MAIL_FROM_NAME=Fides
MAIL_FROM_EMAIL=no-reply@fides.app

# -----------------------------------------------------------------------------
# Local development (optional)
# -----------------------------------------------------------------------------
# Direct Postgres connection string used by the Supabase CLI for local dev.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
