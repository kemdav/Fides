# =============================================================================
# FIDES .env.local  (never commit this file)
# After editing, STOP and restart `npm run dev` so the changes load.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Use your real https URL when deployed: it becomes the login link in the "Account approved" email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost:3000

# --- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://kzeeiudtjgydkeygoeoj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_pI1pWdav2g913SOmW0GGtw_y2OeHD7D
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Admin access is now a local login: edit src/lib/admin/local-accounts.ts (ADMIN_PORTAL_PUBLIC_ACCESS is no longer used).
# Optional: ADMIN_SESSION_SECRET=<long random string> to sign the admin session cookie.

# --- Email: Gmail SMTP (works with NO custom domain, sends to ANY address) -------
# 1) Gmail account -> turn on 2-Step Verification
# 2) https://myaccount.google.com/apppasswords -> create an app password (16 letters)
# 3) Replace BOTH placeholders below, brackets included. Paste the app password WITHOUT spaces.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=fides.notifications@gmail.com
SMTP_PASS=kknrwatwjwpxtlrf
MAIL_FROM_NAME=FIDES
# Must be the SAME Gmail address as SMTP_USER (Gmail rewrites any other sender).
MAIL_FROM_EMAIL=fides.notifications@gmail.com

# --- Resend (disabled) ----------------------------------------------------------
# Resend cannot send to other people without a verified domain, so it is not used.
# Kept here only in case you add a domain later (then set MAIL_TRANSPORT=resend and MAIL_FROM_EMAIL).
# RESEND_API_KEY=your_resend_api_key

# --- AI concierge (optional) -----------------------------------------------------
# GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-2.0-flash
AI_CONCIERGE_TIMEOUT_MS=3000
