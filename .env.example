###############################################################################
# FIDES — .env.local
#
# Why they disagreed: the commits read DIFFERENT variable names for the same
# thing (…_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY  vs  …_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY)
# and pointed at different databases. This file defines EVERY name and fills
# them all from whichever database you choose below.
#
###############################################################################
───────────────────────────────────────────────────────────────────────┘
FIDES_DB=DOCKER


# ─────────────────────────────────────────────────────────────────────────────
# 2. CLOUD database values  (Supabase Dashboard -> Project Settings -> API Keys)
# ─────────────────────────────────────────────────────────────────────────────
CLOUD_SUPABASE_URL=https://kzeeiudtjgydkeygoeoj.supabase.co
# Publishable key (sb_publishable_...) — safe for the browser.
CLOUD_SUPABASE_PUBLIC_KEY=sb_publishable_pI1pWdav2g913SOmW0GGtw_y2OeHD7D
# Secret key (sb_secret_...) — SERVER ONLY, bypasses Row Level Security.
# CLOUD_SUPABASE_SECRET_KEY=your_cloud_supabase_secret_key
# Optional (only for server-side JWT verification). Leave empty if you don't have it.
CLOUD_SUPABASE_JWT_SECRET=
CLOUD_PLATFORM_DOMAIN=localhost:3000


# ─────────────────────────────────────────────────────────────────────────────
# 3. DOCKER database values  (`npx supabase start` then `npx supabase status`)
#    These are Supabase's public local-development defaults — identical on every
#    machine, not secret. If `supabase status` shows different keys, paste them here.
# ─────────────────────────────────────────────────────────────────────────────
DOCKER_SUPABASE_URL=http://127.0.0.1:54321
DOCKER_SUPABASE_PUBLIC_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# DOCKER_SUPABASE_SECRET_KEY=your_docker_supabase_secret_key
DOCKER_SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
DOCKER_PLATFORM_DOMAIN=fides.app


# ─────────────────────────────────────────────────────────────────────────────
# 4. ACTIVE SETTINGS  —  DO NOT EDIT
#    Every variable name any of the commits reads, filled from the database
#    chosen in section 1. (Two names, same value, on purpose.)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# SUPABASE_SECRET_KEY=your_supabase_secret_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost:3000


# ─────────────────────────────────────────────────────────────────────────────
# 5. SITE
#    Use your real https URL when deployed: it becomes the login link in the
#    "Account approved" email.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev convenience: lets you open /admin without an admin login. Set to false (or delete) outside local development.
ADMIN_PORTAL_PUBLIC_ACCESS=true


# ─────────────────────────────────────────────────────────────────────────────
# 6. EMAIL — Gmail SMTP (works with NO custom domain, sends to ANY address)
#    Same settings for Cloud and Docker. Gmail App Password: paste it WITHOUT spaces.
#    MAIL_FROM_EMAIL must be the SAME Gmail address as SMTP_USER.
#    To turn email off locally, blank SMTP_HOST (mail then falls back to the console).
# ─────────────────────────────────────────────────────────────────────────────
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=fides.notifications@gmail.com
SMTP_PASS=kknrwatwjwpxtlrf
MAIL_FROM_NAME=FIDES
MAIL_FROM_EMAIL=fides.notifications@gmail.com

# Resend is not used (it cannot send to other people without a verified domain).
# RESEND_API_KEY=<only-if-you-add-a-verified-domain-later>


# ─────────────────────────────────────────────────────────────────────────────
# 7. AI concierge (optional)
# ─────────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=<gemini-api-key-from-aistudio.google.com/app/apikey>
GEMINI_MODEL=gemini-2.0-flash
AI_CONCIERGE_TIMEOUT_MS=3000
